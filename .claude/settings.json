{
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(pwd:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(mkdir:*)",
            "Bash(touch:*)",
            "Bash(cp:*)",
            "Bash(mv:*)",
            "Bash(echo:*)",
            "Bash(chmod +x:*)",
            "Bash(chmod 755:*)",
            "Bash(chmod 644:*)",
            "Bash(chmod 600:*)",
            "Bash(git:*)",
            "Bash(gh:*)",
            "Bash(but:*)",
            "Bash(npm:*)",
            "Bash(npx:*)",
            "Bash(node:*)",
            "Bash(yarn:*)",
            "Bash(pnpm:*)",
            "Bash(uv:*)",
            "Bash(python:*)",
            "Bash(python3:*)",
            "Bash(sqlite3:*)",
            "Bash(psql:*)",
            "Bash(pip:*)",
            "Bash(pip3:*)",
            "Bash(poetry:*)",
            "Bash(pytest:*)",
            "Bash(mypy:*)",
            "Bash(ruff:*)",
            "Bash(make:*)",
            "Bash(jq:*)",
            "Bash(lsof:*)",
            "Bash(docker build:*)",
            "Bash(docker run:*)",
            "Bash(docker ps:*)",
            "Bash(docker logs:*)",
            "Bash(docker stop:*)",
            "Bash(docker-compose:*)",
            "Bash(source .venv/bin/activate)",
            "Bash(chmod +x:*)",
            "Bash(chmod 755:*)",
            "Bash(chmod 644:*)",
            "Bash(chmod 600:*)",
            "Bash(TZ=UTC date:*)",
            "Bash(crontab:*)"
        ],
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.development.local)",
            "Read(**/.env.production)",
            "Read(**/.env.production.local)",
            "Read(**/.env.staging)",
            "Read(**/*.key)",
            "Read(**/*.pem)",
            "Read(**/credentials*)",
            "Read(**/secrets/**)",
            "Read(**/.ssh/**)",
            "Read(**/.aws/**)",
            "Write(**/.env)",
            "Write(**/.env.local)",
            "Write(**/.env.production)",
            "Write(**/.env.staging)",
            "Write(**/*.key)",
            "Write(**/*.pem)",
            "Write(**/credentials*)",
            "Write(**/secrets/**)",
            "Write(**/.ssh/**)",
            "Write(**/.aws/**)",
            "Bash(rm -rf:*)",
            "Bash(rm -fr:*)",
            "Bash(rm -r:*)",
            "Bash(rm --recursive:*)",
            "Bash(sudo:*)",
            "Bash(su:*)",
            "Bash(chmod +s:*)",
            "Bash(chmod u+s:*)",
            "Bash(chmod g+s:*)",
            "Bash(chmod 777:*)",
            "Bash(chmod 0777:*)",
            "Bash(chmod 666:*)",
            "Bash(chmod -R 777:*)",
            "Bash(chmod -R 666:*)",
            "Bash(chmod a=rwx:*)",
            "Bash(shutdown:*)",
            "Bash(reboot:*)",
            "Bash(docker run --privileged:*)",
            "Bash(docker system prune:*)",
            "Bash(npm publish:*)",
            "Bash(pip install --break-system-packages:*)"
        ],
        "ask": [
            "Bash(curl:*)",
            "Bash(wget:*)",
            "WebFetch",
            "Bash(rm:*)",
            "Bash(chmod:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write(*.py)",
                "hooks": [
                    {
                        "type": "command",
                        "command": "ruff check --fix --select I \"$file\" 2>/dev/null || true"
                    },
                    {
                        "type": "command",
                        "command": "ruff format \"$file\" 2>/dev/null || true"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/verify.sh"
                    },
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/notify-stop.sh"
                    }
                ]
            }
        ]
    }
}