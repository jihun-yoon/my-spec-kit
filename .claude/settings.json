{
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(pwd:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(mkdir:*)",
            "Bash(touch:*)",
            "Bash(cp:*)",
            "Bash(mv:*)",
            "Bash(echo:*)",
            "Bash(chmod +x:*)",
            "Bash(chmod 755:*)",
            "Bash(chmod 644:*)",
            "Bash(git:*)",
            "Bash(gh:*)",
            "Bash(but:*)",
            "Bash(npm:*)",
            "Bash(npx:*)",
            "Bash(node:*)",
            "Bash(uv:*)",
            "Bash(python3:*)",
            "Bash(pip:*)",
            "Bash(pip3:*)",
            "Bash(pytest:*)"
        ],
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.production)",
            "Read(**/*.key)",
            "Read(**/*.pem)",
            "Read(**/credentials*)",
            "Read(**/secrets/**)",
            "Write(**/.env)",
            "Write(**/.env.local)",
            "Write(**/.env.production)",
            "Write(**/*.key)",
            "Write(**/*.pem)",
            "Bash(rm -rf:*)",
            "Bash(rm -fr:*)",
            "Bash(sudo:*)",
            "Bash(chmod 777:*)"
        ]
    }
}
